<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SwagLabs Cross Browser Suite">

    <test name="Firefox Tests">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="ecom.bitm.SwagLabsCart.CartpageTest"/>
            <class name="ecom.bitm.SwagLabsLogin.LoginPageNegative"/>
            <class name="ecom.bitm.SwagLabsHamBurger.HamburgerTest"/>
            <class name="ecom.bitm.SwagLabsProduct.ProductNegativeTest"/>
            <class name="ecom.bitm.SwagLabsCart.CartpageNegativeTest"/>
            <class name="ecom.bitm.SwagLabsCheckOut.CheckOutNegativeTest"/>
            <class name="ecom.bitm.SwagLabsLogin.LoginPageTest"/>
            <class name="ecom.bitm.SwagLabsProduct.ProductTest"/>
            <class name="ecom.bitm.SwagLabsCheckOut.Checkoutpage"/>
            <class name="ecom.bitm.SwagLabsHamBurger.HamburgerNegativeTest"/>
        </classes>
    </test>

    <test name="Chrome Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="ecom.bitm.SwagLabsCart.CartpageTest"/>
            <class name="ecom.bitm.SwagLabsLogin.LoginPageNegative"/>
            <class name="ecom.bitm.SwagLabsHamBurger.HamburgerTest"/>
            <class name="ecom.bitm.SwagLabsProduct.ProductNegativeTest"/>
            <class name="ecom.bitm.SwagLabsCart.CartpageNegativeTest"/>
            <class name="ecom.bitm.SwagLabsCheckOut.CheckOutNegativeTest"/>
            <class name="ecom.bitm.SwagLabsLogin.LoginPageTest"/>
            <class name="ecom.bitm.SwagLabsProduct.ProductTest"/>
            <class name="ecom.bitm.SwagLabsCheckOut.Checkoutpage"/>
            <class name="ecom.bitm.SwagLabsHamBurger.HamburgerNegativeTest"/>
        </classes>
    </test>

</suite>
